                ),
              ],
            ),
          ),

          pw.SizedBox(height: 14),

          // 2. Seção Financiamento bancário
          pw.Text(
            'Financiamento bancário',
            style: pw.TextStyle(
              fontSize: 14.5,
              fontWeight: pw.FontWeight.bold,
              color: const PdfColor.fromInt(0xFF102C49),
            ),
          ),
          pw.SizedBox(height: 10),

          // Grid 2x2 dos Bancos
          pw.Row(
            children: [
              pw.Expanded(child: _buildBankCard(banksToRender[0], proposal.totalAmount, primaryColor, primaryHex)),
              pw.SizedBox(width: 12),
              pw.Expanded(child: _buildBankCard(banksToRender[1], proposal.totalAmount, primaryColor, primaryHex)),
            ],
          ),
          pw.SizedBox(height: 12),
          pw.Row(
            children: [
              pw.Expanded(child: _buildBankCard(banksToRender[2], proposal.totalAmount, primaryColor, primaryHex)),
              pw.SizedBox(width: 12),
              pw.Expanded(child: _buildBankCard(banksToRender[3], proposal.totalAmount, primaryColor, primaryHex)),
            ],
          ),

          pw.Spacer(),

          // 3. Seção Parcelamento no cartão de crédito
          pw.Text(
            'Parcelamento no cartão de crédito',
            style: pw.TextStyle(
              fontSize: 14.5,
              fontWeight: pw.FontWeight.bold,
              color: const PdfColor.fromInt(0xFF102C49),
            ),
          ),
          pw.SizedBox(height: 10),

          pw.Container(
            padding: const pw.EdgeInsets.all(16),
            decoration: pw.BoxDecoration(
              color: secondaryColor,
              borderRadius: const pw.BorderRadius.all(pw.Radius.circular(14)),
            ),
            child: pw.Row(
              crossAxisAlignment: pw.CrossAxisAlignment.center,
              children: [
                pw.Expanded(
                  flex: 46,
                  child: pw.Column(
                    crossAxisAlignment: pw.CrossAxisAlignment.start,
                    children: [
                      pw.SvgImage(
                        svg: cardIllustrationSvg,
                        width: 90,
                        height: 56,
                      ),
                      pw.SizedBox(height: 8),
                      pw.Text(
                        'BANDEIRAS ACEITAS',
                        style: pw.TextStyle(
                          fontSize: 7.2,
                          fontWeight: pw.FontWeight.bold,
                          color: _lightenPdfColor(secondaryColor, 0.55),
                          letterSpacing: 0.8,
                        ),
                      ),
                      pw.SizedBox(height: 7),
                      pw.Row(
                        children: ['VISA', 'MASTERCARD', 'ELO'].map((b) => _buildCardBrandBadge(b)).toList(),
                      ),
                      pw.SizedBox(height: 5),
                      pw.Row(
                        children: ['AMEX', 'HIPERCARD', 'DINERS CLUB'].map((b) => _buildCardBrandBadge(b)).toList(),
                      ),
                    ],
                  ),
                ),

                pw.SizedBox(width: 14),

                pw.Expanded(
                  flex: 54,
                  child: pw.Column(
                    crossAxisAlignment: pw.CrossAxisAlignment.stretch,
                    children: [
                      ...[3, 6, 9, 12].map((installments) {
                        final rateItem = settings.creditCardRates.firstWhere(
                          (r) => r.installment == installments,
                          orElse: () => CreditCardInstallmentRateDTO(
                              installment: installments, feePercentage: installments * 1.05),
                        );
                        final val = rateItem.calculateInstallmentValue(proposal.totalAmount);

                        return pw.Container(
                          margin: pw.EdgeInsets.only(bottom: installments == 12 ? 0 : 6),
                          padding: const pw.EdgeInsets.symmetric(horizontal: 14, vertical: 7.5),
                          decoration: pw.BoxDecoration(
                            color: _darkenPdfColor(secondaryColor, 0.45),
                            borderRadius: const pw.BorderRadius.all(pw.Radius.circular(8)),
                            border: pw.Border.all(
                              color: _darkenPdfColor(secondaryColor, 0.25),
                              width: 0.7,
                            ),
                          ),
                          child: pw.Row(
                            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                            children: [
                              pw.Text(
                                '$installments' 'x no cartão',
                                style: const pw.TextStyle(
                                  fontSize: 9.2,
                                  color: PdfColor.fromInt(0xFFCBD5E1),
                                ),
                              ),
                              pw.Text(
                                _currencyFormat.format(val),
                                style: pw.TextStyle(
                                  fontSize: 12.0,
                                  fontWeight: pw.FontWeight.bold,
                                  color: PdfColors.white,
                                ),
                              ),
                            ],
                          ),
                        );
                      }),
                    ],
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  static pw.Widget _buildCardBrandBadge(String brand) {
    return pw.Expanded(
      child: pw.Container(
        margin: const pw.EdgeInsets.only(right: 5),
        padding: const pw.EdgeInsets.symmetric(horizontal: 4, vertical: 4.5),
        decoration: const pw.BoxDecoration(
          color: PdfColors.white,
          borderRadius: pw.BorderRadius.all(pw.Radius.circular(4)),
        ),
        child: pw.Center(
          child: pw.Text(
            brand,
            style: pw.TextStyle(
              fontSize: 6.5,
              fontWeight: pw.FontWeight.bold,
              color: const PdfColor.fromInt(0xFF102C49),
            ),
            maxLines: 1,
          ),
        ),
      ),
    );
  }

  static pw.Widget _buildBankCard(
    SolarFinancingBankDTO bank,
    double totalAmount,
    PdfColor primaryColor,
    String primaryHex,
  ) {
    final lowerName = '${bank.id} ${bank.name}'.toLowerCase();
    PdfColor ratePillBg = const PdfColor.fromInt(0xFFEFF6FF);
    PdfColor ratePillText = const PdfColor.fromInt(0xFF0284C7);
    if (lowerName.contains('solfacil') || lowerName.contains('solfácil') || lowerName.contains('sicredi')) {
      ratePillBg = const PdfColor.fromInt(0xFFEAF7EE);
      ratePillText = const PdfColor.fromInt(0xFF15803D);
    } else if (lowerName.contains('santander')) {
      ratePillBg = const PdfColor.fromInt(0xFFFEF2F2);
      ratePillText = const PdfColor.fromInt(0xFFDC2626);
    }

    final installments = bank.enabledInstallments.take(5).toList();

    return pw.Container(
      padding: const pw.EdgeInsets.symmetric(horizontal: 14, vertical: 12),
      decoration: pw.BoxDecoration(
        color: PdfColors.white,
        borderRadius: const pw.BorderRadius.all(pw.Radius.circular(12)),
        border: pw.Border.all(color: const PdfColor.fromInt(0xFFE2E8F0), width: 0.9),
      ),
      child: pw.Column(
        crossAxisAlignment: pw.CrossAxisAlignment.stretch,
        children: [
          pw.Row(
            mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
            crossAxisAlignment: pw.CrossAxisAlignment.center,
            children: [
              _buildBankLogoWidget(bank, primaryColor),
              pw.Container(
                padding: const pw.EdgeInsets.symmetric(horizontal: 9, vertical: 3.5),
                decoration: pw.BoxDecoration(
                  color: ratePillBg,
                  borderRadius: const pw.BorderRadius.all(pw.Radius.circular(12)),
                ),
                child: pw.Text(
                  '${bank.monthlyInterestRate.toStringAsFixed(2).replaceAll('.', ',')}% a.m.',
                  style: pw.TextStyle(
                    fontSize: 7.5,
                    fontWeight: pw.FontWeight.bold,
                    color: ratePillText,
                  ),
                ),
              ),
            ],
          ),
          pw.SizedBox(height: 10),
          for (int i = 0; i < installments.length; i++)
            pw.Container(
              padding: const pw.EdgeInsets.symmetric(horizontal: 6, vertical: 3.5),
              decoration: pw.BoxDecoration(
                color: i.isEven ? const PdfColor.fromInt(0xFFF4F8FB) : PdfColors.white,
                borderRadius: const pw.BorderRadius.all(pw.Radius.circular(4)),
              ),
              child: pw.Row(
                mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                children: [
                  pw.Text(
                    '${installments[i]}x',
                    style: pw.TextStyle(
                      fontSize: 8.5,
                      fontWeight: pw.FontWeight.bold,
                      color: const PdfColor.fromInt(0xFF475569),
                    ),
                  ),
                  pw.Text(
                    _currencyFormat.format(bank.calculateInstallment(totalAmount, installments[i])),
                    style: pw.TextStyle(
                      fontSize: 9.5,
                      fontWeight: pw.FontWeight.bold,
                      color: const PdfColor.fromInt(0xFF0F172A),
                    ),
                  ),
                ],
              ),
            ),
        ],
      ),
    );
  }

  static pw.Widget _buildBankLogoWidget(SolarFinancingBankDTO bank, PdfColor primaryColor) {
    if (bank.logoBase64 != null && bank.logoBase64!.trim().isNotEmpty) {
      try {
        final clean = bank.logoBase64!.contains(',')
            ? bank.logoBase64!.split(',').last
            : bank.logoBase64!;
        final bytes = base64Decode(clean.trim());
        if (bytes.isNotEmpty) {
          return pw.SizedBox(
            height: 22,
            child: pw.Image(pw.MemoryImage(bytes), height: 22, fit: pw.BoxFit.contain),
          );
        }
      } catch (_) {}
    }

    final key = '${bank.id} ${bank.name}'.toLowerCase();

    if (key.contains('solfacil') || key.contains('solfácil')) {
      return pw.Row(
        mainAxisSize: pw.MainAxisSize.min,
        crossAxisAlignment: pw.CrossAxisAlignment.center,
        children: [
          pw.Text('s', style: const pw.TextStyle(fontSize: 17, color: PdfColor.fromInt(0xFF111827))),
          pw.SizedBox(width: 1),
          pw.SvgImage(
            svg: '<svg viewBox="0 0 24 24" width="15" height="15"><circle cx="12" cy="12" r="5" fill="#FACC15"/><path d="M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" stroke="#FACC15" stroke-width="2.4" stroke-linecap="round"/></svg>',
            width: 15,
            height: 15,
          ),
          pw.SizedBox(width: 1),
          pw.Text('lfácil', style: const pw.TextStyle(fontSize: 17, color: PdfColor.fromInt(0xFF111827))),
        ],
      );
    }

    if (key.contains('santander')) {
      return pw.Row(
        mainAxisSize: pw.MainAxisSize.min,
        crossAxisAlignment: pw.CrossAxisAlignment.center,
        children: [
          pw.SvgImage(
            svg: '<svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 2c-.4 3.1-3.4 4.5-3.4 7.7 0 1.4.8 2.6 1.7 3.4-.5-1.3-.1-2.8 1-3.9.4 1.6 1.8 2.3 1.8 4.2 0 1.3-.7 2.4-1.7 3.2 2.9-.4 5.1-2.6 5.1-5.6 0-3.2-3.4-4.7-4.5-9zM7 11.2c-2.6.9-4.5 2.7-4.5 4.8 0 2.8 4.2 5 9.5 5s9.5-2.2 9.5-5c0-2-1.8-3.8-4.3-4.7.6 1.1.8 2.3.5 3.6-1.1 1.6-3.4 2.5-5.7 2.5-2.6 0-4.9-1.1-5.8-2.9-.2-1.1.1-2.2.8-3.3z" fill="#EC0000"/></svg>',
            width: 16,
            height: 16,
          ),
          pw.SizedBox(width: 5),
          pw.Text(
            'Santander',
            style: pw.TextStyle(
              fontSize: 14.5,
              fontWeight: pw.FontWeight.bold,
              color: const PdfColor.fromInt(0xFFEC0000),
            ),
          ),
        ],
      );
    }

    if (key.contains('sicredi')) {
      return pw.Row(
        mainAxisSize: pw.MainAxisSize.min,
        crossAxisAlignment: pw.CrossAxisAlignment.center,
        children: [
          pw.SvgImage(
            svg: '<svg viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="12" r="10" fill="none"/><path d="M12 2c2 3 2 6 0 8-2-2-2-5 0-8zM22 12c-3 2-6 2-8 0 2-2 5-2 8 0zM12 22c-2-3-2-6 0-8 2 2 2 5 0 8zM2 12c3-2 6-2 8 0-2 2-5 2-8 0zM19.1 4.9c-.7 3.5-2.8 5.6-5.6 5.6 0-2.8 2.1-4.9 5.6-5.6zM19.1 19.1c-3.5-.7-5.6-2.8-5.6-5.6 2.8 0 4.9 2.1 5.6 5.6zM4.9 19.1c.7-3.5 2.8-5.6 5.6-5.6 0 2.8-2.1 4.9-5.6 5.6zM4.9 4.9c3.5.7 5.6 2.8 5.6 5.6-2.8 0-4.9-2.1-5.6-5.6z" fill="#3FA110"/></svg>',
            width: 16,
            height: 16,
          ),
          pw.SizedBox(width: 5),
          pw.Text(
            'Sicredi',
            style: pw.TextStyle(
              fontSize: 15.5,
              fontWeight: pw.FontWeight.bold,
              color: const PdfColor.fromInt(0xFF3FA110),
            ),
          ),
        ],
      );
    }

    if (key.contains('bv')) {
      return pw.Row(
        mainAxisSize: pw.MainAxisSize.min,
        crossAxisAlignment: pw.CrossAxisAlignment.center,
        children: [
          pw.SvgImage(
            svg: '<svg viewBox="0 0 28 24" width="22" height="18"><path d="M2 2h7c3 0 5 1.5 5 4.2 0 1.8-1 3.1-2.5 3.6 1.9.5 3 2 3 4.1 0 3-2.3 5.1-5.8 5.1H2V2zm4.2 6.4h2.4c1.2 0 1.9-.6 1.9-1.6s-.7-1.6-1.9-1.6H6.2v3.2zm0 7.2h2.8c1.4 0 2.2-.7 2.2-1.8 0-1.1-.8-1.8-2.2-1.8H6.2v3.6z" fill="#1D4ED8"/><path d="M13 6h4.2l3.1 9.5L23.4 6H27.5l-5.3 15h-4L13 6z" fill="#06B6D4"/></svg>',
            width: 22,
            height: 18,
          ),
          pw.SizedBox(width: 5),
          pw.Text(
            bank.name,
            style: pw.TextStyle(
              fontSize: 11.5,
              fontWeight: pw.FontWeight.bold,
              color: const PdfColor.fromInt(0xFF102C49),
            ),
          ),
        ],
      );
    }

    return pw.Text(
      bank.name,
      style: pw.TextStyle(
        fontSize: 12.5,
        fontWeight: pw.FontWeight.bold,
        color: primaryColor,
      ),
    );
  }

  static String _pdfColorToHex(PdfColor color) {
    final r = (color.red * 255).round().toRadixString(16).padLeft(2, '0');
    final g = (color.green * 255).round().toRadixString(16).padLeft(2, '0');
    final b = (color.blue * 255).round().toRadixString(16).padLeft(2, '0');
    return '#$r$g$b';
  }

  static String _getComponentIcon(String item, String hex) {
    final upper = item.toUpperCase();
    if (upper.contains('INVERSOR') || upper.contains('MICRO')) {
      return SolarPdfIcons.inverterBox(hex);
    } else if (upper.contains('MÓDULO') ||
        upper.contains('MODULO') ||
        upper.contains('PAINEL') ||
        upper.contains('PLACA') ||
        upper.contains('FOTOVOLTAICO')) {
      return SolarPdfIcons.panelGrid(hex);
    } else if (upper.contains('ESTRUTURA') ||
        upper.contains('PERFIL') ||
        upper.contains('FIXAÇÃO') ||
        upper.contains('FIXACAO') ||
        upper.contains('TELHADO') ||
        upper.contains('TELHA')) {
      return SolarPdfIcons.roof(hex);
    } else if (upper.contains('STRING') ||
        upper.contains('DPS') ||
        upper.contains('CHAVE') ||
        upper.contains('QUADRO') ||
        upper.contains('PROTEÇÃO') ||
        upper.contains('PROTECAO')) {
      return SolarPdfIcons.shieldCheck(hex);
    } else if (upper.contains('CABO') || upper.contains('CONECTOR') || upper.contains('MC4')) {
      return SolarPdfIcons.cablePlug(hex);
    } else if (upper.contains('HOMOLOGAÇÃO') ||
        upper.contains('HOMOLOGACAO') ||
        upper.contains('ENGENHARIA') ||
        upper.contains('PROJETO') ||
        upper.contains('ART')) {
      return SolarPdfIcons.documentFile(hex);
    } else {
      return SolarPdfIcons.solarTech(hex);
    }
  }
}
EOF

RUN cat <<'EOF' > /app/bin/server.dart
import 'dart:convert';
import 'dart:io';
import 'package:shelf/shelf.dart';
import 'package:shelf/shelf_io.dart' as io;
import 'package:shelf_router/shelf_router.dart';

import 'package:mavis_microservice/generator/solar_credit_boleto_engine.dart';
import 'package:mavis_microservice/generator/solar_proposal_pdf_engine.dart';
import 'package:mavis_microservice/models/proposal_dto.dart';
import 'package:mavis_microservice/models/solar_credit_dto.dart';
import 'package:mavis_microservice/services/firebase_storage_service.dart';
import 'package:mavis_microservice/services/firestore_gd_service.dart';
import 'package:mavis_microservice/services/firestore_settings_service.dart';

void main(List<String> args) async {
  final app = Router();

  // Health check
  app.get('/health', (Request request) {
    return Response.ok(
      jsonEncode({
        'status': 'online',
        'service': 'Mavis PDF Generator Microservice',
        'engine': 'Dart Native PDF 6-Pages Solar Engine (Synced with CRM Firestore)',
        'timestamp': DateTime.now().toIso8601String(),
      }),
      headers: {'Content-Type': 'application/json; charset=utf-8'},
    );
  });

  app.get('/', (Request request) {
    return Response.ok(
      jsonEncode({
        'status': 'online',
        'endpoints': {
          '/health': 'GET - Verifica integridade do serviço',
          '/generate': 'POST - Gera PDF sincronizado com Firestore, salva no Storage e retorna URLs + Base64',
          '/generate/raw': 'POST - Gera PDF sincronizado com Firestore e retorna os bytes brutos (application/pdf)',
          '/gd/check-uc': 'POST - Verifica se a UC é recebedora em Créditos Solares (GD) para heitorklaus@hotmail.com e retorna resumo + botões',
          '/gd/generate-boleto': 'POST - Gera PDF do Boleto/Demonstrativo GD, salva no Firestore/Storage e retorna URL + Base64',
          '/gd/action': 'POST - Trata cliques nos botões pré-definidos (GD_GERAR_BOLETO, GD_GERAR_PROPOSTA, GD_CANCELAR)',
        },
      }),
      headers: {'Content-Type': 'application/json; charset=utf-8'},
    );
  });

  // Geração de Proposta Comercial (JSON + Storage Upload + Base64)
  app.post('/generate', (Request request) async {
    try {
      final bodyText = await request.readAsString();
      if (bodyText.trim().isEmpty) {
        return Response.badRequest(
          body: jsonEncode({'error': 'Corpo da requisição vazio'}),
          headers: {'Content-Type': 'application/json'},
        );
      }

      final Map<String, dynamic> body = jsonDecode(bodyText);

      Map<String, dynamic> proposalMap;
      if (body.containsKey('proposal')) {
        proposalMap = Map<String, dynamic>.from(body['proposal'] as Map);
      } else {
        proposalMap = body;
      }

      final proposal = ProposalDTO.fromMap(proposalMap);

      Map<String, dynamic>? reqSettingsMap;
      if (body.containsKey('settings') && body['settings'] is Map) {
        reqSettingsMap = Map<String, dynamic>.from(body['settings'] as Map);
      }

      // Busca automaticamente as configurações vivas do CRM no Firestore (companies/{companyId}/sector_settings/solarPlant)
      final settings = await FirestoreSettingsService.resolveSettings(
        proposal: proposal,
        requestSettingsMap: reqSettingsMap,
      );

      print('🚀 [mavis-pdf] Compilando PDF oficial sincronizado para: ${proposal.proposalNumber} (${proposal.clientName})');
      final pdfBytes = await SolarProposalPdfEngine.generatePdf(
        proposal: proposal,
        settings: settings,
      );

      // Upload opcional/automático para o Storage
      final shouldUpload = body['uploadToStorage'] != false;
      Map<String, String>? storageResult;

      if (shouldUpload) {
        storageResult = await FirebaseStorageService.uploadProposalPdf(
          pdfBytes: pdfBytes,
          proposal: proposal,
        );
      }

      final pdfBase64 = base64Encode(pdfBytes);

      return Response.ok(
        jsonEncode({
          'success': true,
          'proposalNumber': proposal.proposalNumber,
          'clientName': proposal.clientName,
          'totalAmount': proposal.totalAmount,
          'pdfUrl': storageResult?['pdfUrl'],
          'pdfPath': storageResult?['pdfPath'],
          'fileName': storageResult?['fileName'] ?? 'Proposta_${proposal.proposalNumber}.pdf',
          'pdfBase64': pdfBase64,
          'bytesLength': pdfBytes.lengthInBytes,
        }),
        headers: {
          'Content-Type': 'application/json; charset=utf-8',
          'Access-Control-Allow-Origin': '*',
        },
      );
    } catch (e, stack) {
      print('❌ [mavis-pdf] Erro ao gerar proposta: $e\n$stack');
      return Response.internalServerError(
        body: jsonEncode({'error': e.toString()}),
        headers: {'Content-Type': 'application/json'},
      );
    }
  });

  // Retorno direto do arquivo binário (application/pdf)
  app.post('/generate/raw', (Request request) async {
    try {
      final bodyText = await request.readAsString();
      final Map<String, dynamic> body = jsonDecode(bodyText);
      final proposalMap = body.containsKey('proposal')
          ? Map<String, dynamic>.from(body['proposal'] as Map)
          : body;

      final proposal = ProposalDTO.fromMap(proposalMap);

      Map<String, dynamic>? reqSettingsMap;
      if (body.containsKey('settings') && body['settings'] is Map) {
        reqSettingsMap = Map<String, dynamic>.from(body['settings'] as Map);
      }

      final settings = await FirestoreSettingsService.resolveSettings(
        proposal: proposal,
        requestSettingsMap: reqSettingsMap,
      );

      final pdfBytes = await SolarProposalPdfEngine.generatePdf(
        proposal: proposal,
        settings: settings,
      );

      return Response.ok(
        pdfBytes,
        headers: {
          'Content-Type': 'application/pdf',
          'Content-Disposition': 'inline; filename="Proposta_${proposal.proposalNumber}.pdf"',
          'Access-Control-Allow-Origin': '*',
        },
      );
    } catch (e) {
      return Response.internalServerError(
        body: jsonEncode({'error': e.toString()}),
        headers: {'Content-Type': 'application/json'},
      );
    }
  });

  // ── CRÉDITOS SOLARES (GD): Verificar UC Recebedora + Resumo Ilustrado + Botões ──
  app.post('/gd/check-uc', (Request request) async {
    try {
      final bodyText = await request.readAsString();
      final Map<String, dynamic> body = jsonDecode(bodyText);
      final ucNumber = (body['uc'] ?? body['ucNumber'] ?? '').toString().trim();
      final ownerEmail = body['ownerEmail']?.toString();
      final companyId = body['companyId']?.toString();
      final billData = body['billData'] is Map
          ? Map<String, dynamic>.from(body['billData'] as Map)
          : Map<String, dynamic>.from(body);

      if (!FirestoreGdService.isAllowedForAdmin(ownerEmail: ownerEmail, companyId: companyId)) {
        return Response.ok(
          jsonEncode({
            'allowed': false,
            'isBeneficiary': false,
            'nextAction': 'PROPOSAL_FLOW',
            'reason': 'Fluxo de Créditos Solares (GD) habilitado apenas para heitorklaus@hotmail.com',
          }),
          headers: {'Content-Type': 'application/json; charset=utf-8'},
        );
      }

      if (ucNumber.isEmpty) {
        return Response.badRequest(
          body: jsonEncode({'error': 'Número da UC não informado'}),
          headers: {'Content-Type': 'application/json; charset=utf-8'},
        );
      }

      final beneficiary = body['beneficiary'] is Map
          ? GdBeneficiaryDTO.fromMap(
              Map<String, dynamic>.from(body['beneficiary'] as Map),
              (body['beneficiary']['id'] ?? '').toString(),
            )
          : await FirestoreGdService.findBeneficiaryByUc(
              ucNumber: ucNumber,
              companyId: companyId,
            );

      if (beneficiary == null) {
        return Response.ok(
          jsonEncode({
            'allowed': true,
            'isBeneficiary': false,
            'uc': ucNumber,
            'nextAction': 'PROPOSAL_FLOW',
            'buttons': GdBillCalculationDTO.predefinedButtons(),
          }),
          headers: {'Content-Type': 'application/json; charset=utf-8'},
        );
      }

      final calc = GdBillCalculationDTO.fromBeneficiaryAndBill(
        beneficiary: beneficiary,
        billData: billData,
      );

      return Response.ok(
        jsonEncode({
          'allowed': true,
          'isBeneficiary': true,
          'nextAction': 'AWAIT_GD_BUTTON',
          'beneficiary': beneficiary.toMap(),
          'calculation': calc.toMap(),
          'summaryText': calc.buildWhatsAppSummary(),
          'buttons': GdBillCalculationDTO.predefinedButtons(),
        }),
        headers: {'Content-Type': 'application/json; charset=utf-8'},
      );
    } catch (e, stack) {
      print('❌ [mavis-pdf] Erro em /gd/check-uc: $e\n$stack');
      return Response.internalServerError(
        body: jsonEncode({'error': e.toString()}),
        headers: {'Content-Type': 'application/json; charset=utf-8'},
      );
    }
  });

  // ── CRÉDITOS SOLARES (GD): Gerar PDF do Boleto/Demonstrativo + Salvar no Firestore ──
  app.post('/gd/generate-boleto', (Request request) async {
    try {
      final bodyText = await request.readAsString();
      final Map<String, dynamic> body = jsonDecode(bodyText);
      final ucNumber = (body['uc'] ?? body['ucNumber'] ?? '').toString().trim();
      final ownerEmail = body['ownerEmail']?.toString();
      final companyId = body['companyId']?.toString();
      final saveToFirestore = body['saveToFirestore'] != false;
      final billData = body['billData'] is Map
          ? Map<String, dynamic>.from(body['billData'] as Map)
          : Map<String, dynamic>.from(body);

      if (!FirestoreGdService.isAllowedForAdmin(ownerEmail: ownerEmail, companyId: companyId)) {
        return Response.forbidden(
          jsonEncode({'error': 'Fluxo de Créditos Solares (GD) habilitado apenas para heitorklaus@hotmail.com'}),
          headers: {'Content-Type': 'application/json; charset=utf-8'},
        );
      }

      final beneficiary = body['beneficiary'] is Map
          ? GdBeneficiaryDTO.fromMap(
              Map<String, dynamic>.from(body['beneficiary'] as Map),
              (body['beneficiary']['id'] ?? '').toString(),
            )
          : await FirestoreGdService.findBeneficiaryByUc(
              ucNumber: ucNumber,
              companyId: companyId,
            );

      if (beneficiary == null) {
        return Response.notFound(
          jsonEncode({'error': 'UC $ucNumber não encontrada como recebedora de créditos GD.'}),
          headers: {'Content-Type': 'application/json; charset=utf-8'},
        );
      }

      final calc = GdBillCalculationDTO.fromBeneficiaryAndBill(
        beneficiary: beneficiary,
        billData: billData,
      );

      final pdfBytes = await SolarCreditBoletoEngine.generatePdf(calc: calc);

      String? billDocId;
      if (saveToFirestore) {
        billDocId = await FirestoreGdService.saveBillToFirestore(calc);
      }

      final safeUc = ucNumber.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
      final fileName = 'Boleto_GD_${safeUc}_${DateTime.now().millisecondsSinceEpoch}.pdf';
      final uploadUrl = await FirebaseStorageService.uploadPdf(
        pdfBytes: pdfBytes,
        fileName: 'gd_boletos/$fileName',
      );

      return Response.ok(
        jsonEncode({
          'success': true,
          'billId': billDocId,
          'fileName': fileName,
          'pdfUrl': uploadUrl,
          'pdfBase64': base64Encode(pdfBytes),
          'sizeBytes': pdfBytes.length,
          'summaryText': calc.buildWhatsAppSummary(),
          'calculation': calc.toMap(),
        }),
        headers: {'Content-Type': 'application/json; charset=utf-8'},
      );
    } catch (e, stack) {
      print('❌ [mavis-pdf] Erro em /gd/generate-boleto: $e\n$stack');
      return Response.internalServerError(
        body: jsonEncode({'error': e.toString()}),
        headers: {'Content-Type': 'application/json; charset=utf-8'},
      );
    }
  });

  // ── CRÉDITOS SOLARES (GD): Roteador dos Botões Pré-Definidos (inclui CANCELAR global) ──
  app.post('/gd/action', (Request request) async {
    try {
      final bodyText = await request.readAsString();
      final Map<String, dynamic> body = jsonDecode(bodyText);
      final actionRaw = (body['action'] ?? body['buttonId'] ?? '').toString().trim().toUpperCase();

      if (actionRaw == 'CANCELAR' || actionRaw == 'GD_CANCELAR') {
        return Response.ok(
          jsonEncode({
            'success': true,
            'action': 'RESET_CONVERSATION',
            'resetSession': true,
            'message': '❌ *Atendimento cancelado.* Conversa resetada! Envie uma nova conta de energia ou mensagem quando desejar recomeçar.',
          }),
          headers: {'Content-Type': 'application/json; charset=utf-8'},
        );
      }

      if (actionRaw == 'GERAR PROPOSTA PARA ESTA CONTA' || actionRaw == 'GD_GERAR_PROPOSTA') {
        return Response.ok(
          jsonEncode({
            'success': true,
            'action': 'PROPOSAL_FLOW',
            'resetSession': false,
            'message': '☀️ *Perfeito!* Seguindo com o fluxo normal de geração da *Proposta Comercial* para esta conta...',
          }),
          headers: {'Content-Type': 'application/json; charset=utf-8'},
        );
      }

      if (actionRaw == 'GERAR BOLETO' || actionRaw == 'GD_GERAR_BOLETO') {
        final ucNumber = (body['uc'] ?? body['ucNumber'] ?? '').toString().trim();
        final ownerEmail = body['ownerEmail']?.toString();
        final companyId = body['companyId']?.toString();
        final billData = body['billData'] is Map
            ? Map<String, dynamic>.from(body['billData'] as Map)
            : Map<String, dynamic>.from(body);

        if (!FirestoreGdService.isAllowedForAdmin(ownerEmail: ownerEmail, companyId: companyId)) {
          return Response.forbidden(
            jsonEncode({'error': 'Ação permitida apenas para heitorklaus@hotmail.com'}),
            headers: {'Content-Type': 'application/json; charset=utf-8'},
          );
        }

        final beneficiary = body['beneficiary'] is Map
            ? GdBeneficiaryDTO.fromMap(
                Map<String, dynamic>.from(body['beneficiary'] as Map),
                (body['beneficiary']['id'] ?? '').toString(),
              )
            : await FirestoreGdService.findBeneficiaryByUc(
                ucNumber: ucNumber,
                companyId: companyId,
              );
        if (beneficiary == null) {
          return Response.notFound(
            jsonEncode({'error': 'UC $ucNumber não encontrada como recebedora de créditos GD.'}),
            headers: {'Content-Type': 'application/json; charset=utf-8'},
          );
        }

        final calc = GdBillCalculationDTO.fromBeneficiaryAndBill(
          beneficiary: beneficiary,
          billData: billData,
        );
        final pdfBytes = await SolarCreditBoletoEngine.generatePdf(calc: calc);
        final saveToFirestore = body['saveToFirestore'] != false;
        final billDocId = saveToFirestore ? await FirestoreGdService.saveBillToFirestore(calc) : null;
        final safeUc = ucNumber.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
        final fileName = 'Boleto_GD_${safeUc}_${DateTime.now().millisecondsSinceEpoch}.pdf';
        final uploadUrl = await FirebaseStorageService.uploadPdf(
          pdfBytes: pdfBytes,
          fileName: 'gd_boletos/$fileName',
        );

        return Response.ok(
          jsonEncode({
            'success': true,
            'action': 'SEND_BOLETO_PDF',
            'billId': billDocId,
            'fileName': fileName,
            'pdfUrl': uploadUrl,
            'pdfBase64': base64Encode(pdfBytes),
            'message': '✅ *Boleto / Demonstrativo GD gerado com sucesso!* Segue o PDF para envio ao cliente.',
          }),
          headers: {'Content-Type': 'application/json; charset=utf-8'},
        );
      }

      return Response.badRequest(
        body: jsonEncode({
          'error': 'Ação desconhecida: $actionRaw',
          'validActions': ['GD_GERAR_BOLETO', 'GD_GERAR_PROPOSTA', 'GD_CANCELAR'],
        }),
        headers: {'Content-Type': 'application/json; charset=utf-8'},
      );
    } catch (e, stack) {
      print('❌ [mavis-pdf] Erro em /gd/action: $e\n$stack');
      return Response.internalServerError(
        body: jsonEncode({'error': e.toString()}),
        headers: {'Content-Type': 'application/json; charset=utf-8'},
      );
    }
  });

  // Middleware padrão
  final handler = const Pipeline()
      .addMiddleware(logRequests())
      .addHandler(app.call);

  final port = int.parse(Platform.environment['PORT'] ?? '8080');
  final server = await io.serve(handler, InternetAddress.anyIPv4, port);
  print('☀️ [mavis-pdf] Servidor Nativo Dart rodando na porta ${server.port}');
}
EOF

RUN dart compile exe bin/server.dart -o bin/server

ENV PORT=8080
EXPOSE 8080

CMD ["/app/bin/server"]
