RUN cat <<'EOF' > /app/lib/models/solar_credit_dto.dart
import 'dart:math' as math;

/// Linha individual de Energia Injetada (GD I / GD II) extraída da fatura
class GdInjectedLineDTO {
  final String label;
  final double kwh;
  final double valueRs;
  final String regime; // 'GDI' ou 'GDII'

  const GdInjectedLineDTO({
    required this.label,
    required this.kwh,
    required this.valueRs,
    this.regime = 'GDII',
  });

  factory GdInjectedLineDTO.fromMap(Map<String, dynamic> map) {
    final labelStr = (map['label'] ?? map['description'] ?? 'Energia Atv Injetada').toString();
    final rawRegime = (map['regime'] ?? '').toString().toUpperCase();
    final detectedRegime = rawRegime.isNotEmpty
        ? (rawRegime.contains('GDII') || rawRegime.contains('GD2') || rawRegime.contains('II') ? 'GDII' : 'GDI')
        : (labelStr.toUpperCase().contains('GDII') || labelStr.toUpperCase().contains('GD II') ? 'GDII' : 'GDI');

    return GdInjectedLineDTO(
      label: labelStr,
      kwh: _toDouble(map['kwh']),
      valueRs: _toDouble(map['valueRs'] ?? map['value']).abs(),
      regime: detectedRegime,
    );
  }

  Map<String, dynamic> toMap() => {
        'label': label,
        'kwh': kwh,
        'valueRs': valueRs,
        'regime': regime,
      };
}

/// Beneficiário / Recebedor de Créditos Solares cadastrado no Firestore (`solar_credit_beneficiaries`)
class GdBeneficiaryDTO {
  final String id;
  final String companyId;
  final String clientName;
  final String clientPhone;
  final String accountHolderName;
  final String ucNumber;
  final String normalizedUcDigits;
  final String addressStreet;
  final String addressCity;
  final String addressState;
  final String generatorPlantId;
  final String generatorPlantName;
  final String generatorRegime; // 'gd1' | 'gd2'
  final double utilityAllocationPercent;
  final double clientDiscountPercent;
  final double lastAccumulatedBalanceKwh;
  final String status;

  const GdBeneficiaryDTO({
    required this.id,
    required this.companyId,
    required this.clientName,
    this.clientPhone = '',
    this.accountHolderName = '',
    required this.ucNumber,
    required this.normalizedUcDigits,
    this.addressStreet = '',
    this.addressCity = 'Cuiabá',
    this.addressState = 'MT',
    this.generatorPlantId = '',
    this.generatorPlantName = '',
    this.generatorRegime = 'gd2',
    this.utilityAllocationPercent = 0.0,
    this.clientDiscountPercent = 20.0,
    this.lastAccumulatedBalanceKwh = 0.0,
    this.status = 'active',
  });

  factory GdBeneficiaryDTO.fromMap(Map<String, dynamic> map, String id) {
    final uc = (map['ucNumber'] ?? '').toString().trim();
    final digits = (map['normalizedUcDigits'] ?? uc.replaceAll(RegExp(r'\D'), '')).toString();
    return GdBeneficiaryDTO(
      id: id,
      companyId: (map['companyId'] ?? '').toString().trim(),
      clientName: (map['clientName'] ?? '').toString().trim(),
      clientPhone: (map['clientPhone'] ?? '').toString().trim(),
      accountHolderName: (map['accountHolderName'] ?? '').toString().trim(),
      ucNumber: uc,
      normalizedUcDigits: digits,
      addressStreet: (map['addressStreet'] ?? '').toString().trim(),
      addressCity: (map['addressCity'] ?? 'Cuiabá').toString().trim(),
      addressState: (map['addressState'] ?? 'MT').toString().trim(),
      generatorPlantId: (map['generatorPlantId'] ?? '').toString().trim(),
      generatorPlantName: (map['generatorPlantName'] ?? '').toString().trim(),
      generatorRegime: (map['generatorRegime'] ?? 'gd2').toString().trim(),
      utilityAllocationPercent: _normalizePercent(_toDouble(map['utilityAllocationPercent'])),
      clientDiscountPercent: _normalizePercent(_toDouble(map['clientDiscountPercent'], fallback: 20.0)),
      lastAccumulatedBalanceKwh: _toDouble(map['lastAccumulatedBalanceKwh']),
      status: (map['status'] ?? 'active').toString().trim(),
    );
  }

  Map<String, dynamic> toMap() => {
        'id': id,
        'companyId': companyId,
        'clientName': clientName,
        'clientPhone': clientPhone,
        'accountHolderName': accountHolderName,
        'ucNumber': ucNumber,
        'normalizedUcDigits': normalizedUcDigits,
        'addressStreet': addressStreet,
        'addressCity': addressCity,
        'addressState': addressState,
        'generatorPlantId': generatorPlantId,
        'generatorPlantName': generatorPlantName,
        'generatorRegime': generatorRegime,
        'utilityAllocationPercent': utilityAllocationPercent,
        'clientDiscountPercent': clientDiscountPercent,
        'lastAccumulatedBalanceKwh': lastAccumulatedBalanceKwh,
        'status': status,
      };
}

/// Resultado consolidado do Demonstrativo / Boleto GD (espelha a tela Créditos Solares do CRM)
class GdBillCalculationDTO {
  final GdBeneficiaryDTO beneficiary;
  final String referenceMonth;
  final String dueDate;
  final String ucNumber;
  final String addressStreet;
  final String accountHolderName;
  final double utilityAllocationPercent;
  final double clientDiscountPercent;
  final double accumulatedBalanceKwh;
  final List<GdInjectedLineDTO> injectedLines;

  final double consumptionKwh;
  final double consumptionValueRs;

  final double injectedGdiKwh;
  final double injectedGdiValueRs;
  final double injectedGdiiKwh;
  final double injectedGdiiValueRs;
  final double totalInjectedKwh;
  final double totalInjectedGrossValueRs;

  final double gdAdjustmentKwh;
  final double gdAdjustmentTariff;
  final double gdAdjustmentValueRs;

  final double publicLightingValueRs;
  final double finesAndInterestValueRs;
  final double otherChargesValueRs;
  final double utilityBillTotalToPayRs;

  final double netCompensatedCreditRs;
  final double discountAmountRs;
  final double solarCompanyAmountToPayRs;
  final double totalWithSolarCompanyRs;
  final double totalWithoutSolarCompanyRs;
  final double monthlySavingsRs;
  final double annualProjectedSavingsRs;

  final String? qrCodeImageBase64;
  final String? pixCopyPasteCode;
  final String? paymentLinkUrl;

  const GdBillCalculationDTO({
    required this.beneficiary,
    required this.referenceMonth,
    required this.dueDate,
    required this.ucNumber,
    required this.addressStreet,
    required this.accountHolderName,
    required this.utilityAllocationPercent,
    required this.clientDiscountPercent,
    required this.accumulatedBalanceKwh,
    required this.injectedLines,
    required this.consumptionKwh,
    required this.consumptionValueRs,
    required this.injectedGdiKwh,
    required this.injectedGdiValueRs,
    required this.injectedGdiiKwh,
    required this.injectedGdiiValueRs,
    required this.totalInjectedKwh,
    required this.totalInjectedGrossValueRs,
    required this.gdAdjustmentKwh,
    required this.gdAdjustmentTariff,
    required this.gdAdjustmentValueRs,
    required this.publicLightingValueRs,
    required this.finesAndInterestValueRs,
    required this.otherChargesValueRs,
    required this.utilityBillTotalToPayRs,
    required this.netCompensatedCreditRs,
    required this.discountAmountRs,
    required this.solarCompanyAmountToPayRs,
    required this.totalWithSolarCompanyRs,
    required this.totalWithoutSolarCompanyRs,
    required this.monthlySavingsRs,
    required this.annualProjectedSavingsRs,
    this.qrCodeImageBase64,
    this.pixCopyPasteCode,
    this.paymentLinkUrl,
  });

  factory GdBillCalculationDTO.fromBeneficiaryAndBill({
    required GdBeneficiaryDTO beneficiary,
    required Map<String, dynamic> billData,
  }) {
    final rawLines = billData['injectedLines'] as List<dynamic>? ?? [];
    final injectedLines = rawLines
        .whereType<Map>()
        .map((e) => GdInjectedLineDTO.fromMap(Map<String, dynamic>.from(e)))
        .toList();

    double gdiKwh = _toDouble(billData['injectedGdiKwh']);
    double gdiRs = _toDouble(billData['injectedGdiValueRs']).abs();
    double gdiiKwh = _toDouble(billData['injectedGdiiKwh']);
    double gdiiRs = _toDouble(billData['injectedGdiiValueRs']).abs();

    if (injectedLines.isNotEmpty) {
      gdiKwh = 0;
      gdiRs = 0;
      gdiiKwh = 0;
      gdiiRs = 0;
      for (final line in injectedLines) {
        if (line.regime == 'GDI') {
          gdiKwh += line.kwh;
          gdiRs += line.valueRs;
        } else {
          gdiiKwh += line.kwh;
          gdiiRs += line.valueRs;
        }
      }
    }

    final totalInjKwh = _toDouble(billData['totalInjectedKwh']) > 0
        ? _toDouble(billData['totalInjectedKwh'])
        : (gdiKwh + gdiiKwh);
    final totalInjRs = _toDouble(billData['totalInjectedGrossValueRs']) > 0
        ? _toDouble(billData['totalInjectedGrossValueRs'])
        : (gdiRs + gdiiRs);

    final gdAdjKwh = _toDouble(billData['gdAdjustmentKwh']);
    final gdAdjTariff = _toDouble(billData['gdAdjustmentTariff']);
    final gdAdjRs = _toDouble(billData['gdAdjustmentValueRs']).abs();

    final netCredit = math.max(0.0, totalInjRs - gdAdjRs);
    final discountPct = _toDouble(billData['clientDiscountPercent'], fallback: beneficiary.clientDiscountPercent);
    final discountAmt = netCredit * (discountPct / 100.0);
    final solarPay = netCredit - discountAmt;

    final utilityPay = _toDouble(billData['utilityBillTotalToPayRs'] ?? billData['totalToPayRs']);
    final totalWithSolar = solarPay + utilityPay;
    final totalWithoutSolar = netCredit + utilityPay;
    final savingsMonth = math.max(0.0, totalWithoutSolar - totalWithSolar);
    final savingsYear = savingsMonth * 12.0;

    final refMonth = (billData['referenceMonth'] ?? _defaultRefMonth()).toString().trim();
    final due = (billData['dueDate'] ?? '').toString().trim();
    final uc = (billData['ucNumber'] ?? beneficiary.ucNumber).toString().trim();
    final addr = (billData['addressStreet'] ?? beneficiary.addressStreet).toString().trim();
    final holder = (billData['accountHolderName'] ?? beneficiary.accountHolderName).toString().trim();
    final accBalance = _toDouble(billData['accumulatedBalanceKwh'], fallback: beneficiary.lastAccumulatedBalanceKwh);

    return GdBillCalculationDTO(
      beneficiary: beneficiary,
      referenceMonth: refMonth.isNotEmpty ? refMonth : _defaultRefMonth(),
      dueDate: due.isNotEmpty ? due : '-',
      ucNumber: uc.isNotEmpty ? uc : beneficiary.ucNumber,
      addressStreet: addr.isNotEmpty ? addr : beneficiary.addressStreet,
      accountHolderName: holder.isNotEmpty ? holder : beneficiary.accountHolderName,
      utilityAllocationPercent: _toDouble(
        billData['utilityAllocationPercent'],
        fallback: beneficiary.utilityAllocationPercent,
      ),
      clientDiscountPercent: discountPct,
      accumulatedBalanceKwh: accBalance,
      injectedLines: injectedLines,
      consumptionKwh: _toDouble(billData['consumptionKwh'], fallback: totalInjKwh),
      consumptionValueRs: _toDouble(billData['consumptionValueRs'], fallback: totalInjRs),
      injectedGdiKwh: gdiKwh,
      injectedGdiValueRs: gdiRs,
      injectedGdiiKwh: gdiiKwh,
      injectedGdiiValueRs: gdiiRs,
      totalInjectedKwh: totalInjKwh,
      totalInjectedGrossValueRs: totalInjRs,
      gdAdjustmentKwh: gdAdjKwh,
      gdAdjustmentTariff: gdAdjTariff,
      gdAdjustmentValueRs: gdAdjRs,
      publicLightingValueRs: _toDouble(billData['publicLightingValueRs']),
      finesAndInterestValueRs: _toDouble(billData['finesAndInterestValueRs']),
      otherChargesValueRs: _toDouble(billData['otherChargesValueRs']),
      utilityBillTotalToPayRs: utilityPay,
      netCompensatedCreditRs: netCredit,
      discountAmountRs: discountAmt,
      solarCompanyAmountToPayRs: solarPay,
      totalWithSolarCompanyRs: totalWithSolar,
      totalWithoutSolarCompanyRs: totalWithoutSolar,
      monthlySavingsRs: savingsMonth,
      annualProjectedSavingsRs: savingsYear,
      qrCodeImageBase64: billData['qrCodeImageBase64']?.toString(),
      pixCopyPasteCode: billData['pixCopyPasteCode']?.toString(),
      paymentLinkUrl: billData['paymentLinkUrl']?.toString(),
    );
  }

  Map<String, dynamic> toMap() => {
        'beneficiaryId': beneficiary.id,
        'clientName': beneficiary.clientName,
        'generatorPlantName': beneficiary.generatorPlantName,
        'referenceMonth': referenceMonth,
        'dueDate': dueDate,
        'ucNumber': ucNumber,
        'addressStreet': addressStreet,
        'accountHolderName': accountHolderName,
        'utilityAllocationPercent': utilityAllocationPercent,
        'clientDiscountPercent': clientDiscountPercent,
        'accumulatedBalanceKwh': accumulatedBalanceKwh,
        'injectedLines': injectedLines.map((e) => e.toMap()).toList(),
        'totalInjectedKwh': totalInjectedKwh,
        'totalInjectedGrossValueRs': totalInjectedGrossValueRs,
        'gdAdjustmentValueRs': gdAdjustmentValueRs,
        'netCompensatedCreditRs': netCompensatedCreditRs,
        'discountAmountRs': discountAmountRs,
        'solarCompanyAmountToPayRs': solarCompanyAmountToPayRs,
        'utilityBillTotalToPayRs': utilityBillTotalToPayRs,
        'totalWithSolarCompanyRs': totalWithSolarCompanyRs,
        'totalWithoutSolarCompanyRs': totalWithoutSolarCompanyRs,
        'monthlySavingsRs': monthlySavingsRs,
        'annualProjectedSavingsRs': annualProjectedSavingsRs,
      };

  /// Monta o resumo ilustrado para WhatsApp (com ícones e negrito) espelhando a tela do CRM
  String buildWhatsAppSummary({String brandName = 'Solar 7'}) {
    final buf = StringBuffer();
    buf.writeln('☀️ *CRÉDITOS SOLARES (GD) — RESUMO DA FATURA*');
    buf.writeln('');
    buf.writeln('👤 *Cliente:* *${beneficiary.clientName}*');
    if (beneficiary.generatorPlantName.isNotEmpty) {
      buf.writeln('🏭 *Usina Origem:* ${beneficiary.generatorPlantName}');
    }
    buf.writeln('🔌 *Número da UC:* *$ucNumber*');
    buf.writeln('📅 *Mês de Referência:* *$referenceMonth*  |  📆 *Vencimento:* *$dueDate*');
    if (addressStreet.isNotEmpty) {
      buf.writeln('📍 *Endereço da UC:* $addressStreet');
    }
    if (accountHolderName.isNotEmpty) {
      buf.writeln('🧾 *Titular da Conta:* $accountHolderName');
    }
    buf.writeln(
      '📊 *% Rateio:* ${_fmtPct(utilityAllocationPercent)}  |  🏷️ *Deságio:* *${_fmtPct(clientDiscountPercent)}*  |  🔋 *Saldo Acumulado:* *${_fmtInt(accumulatedBalanceKwh)} kWh*',
    );

    if (injectedLines.isNotEmpty) {
      buf.writeln('');
      buf.writeln('⚡ *Explosão da Fatura (${injectedLines.length} linhas somadas):*');
      for (final line in injectedLines) {
        buf.writeln(
          '   • [${line.regime}] ${line.label}: *${_fmtInt(line.kwh)} kWh* (- ${_fmtCurrency(line.valueRs)})',
        );
      }
    }

    buf.writeln('');
    buf.writeln('🧾 *Resumo do Demonstrativo / Boleto $brandName*');
    buf.writeln('━━━━━━━━━━━━━━━━━━━━');
    buf.writeln('⚡ Energia Injetada Total (${_fmtInt(totalInjectedKwh)} kWh): *${_fmtCurrency(totalInjectedGrossValueRs)}*');
    buf.writeln('⚖️ (-) Ajuste GD II (Lei 14.300/22): *- ${_fmtCurrency(gdAdjustmentValueRs)}*');
    buf.writeln('💎 (=) Crédito Líquido Abatido na Fatura: *${_fmtCurrency(netCompensatedCreditRs)}*');
    buf.writeln('🏷️ (-) Deságio do Cliente (${_fmtPct(clientDiscountPercent)}): *- ${_fmtCurrency(discountAmountRs)}*');
    buf.writeln('');
    buf.writeln('💵 *O valor a pagar para $brandName é de:* *${_fmtCurrency(solarCompanyAmountToPayRs)}*');
    buf.writeln('🏛️ *O valor a pagar para Energisa é de:* ${_fmtCurrency(utilityBillTotalToPayRs)}');
    buf.writeln('✅ *O valor final COM a $brandName é de:* *${_fmtCurrency(totalWithSolarCompanyRs)}*');
    buf.writeln('📄 *O valor final SEM a $brandName SERIA de:* ${_fmtCurrency(totalWithoutSolarCompanyRs)}');
    buf.writeln('');
    buf.writeln('🎉 *Você economizou este mês:* *${_fmtCurrency(monthlySavingsRs)}*');
    buf.writeln('📈 *Economia Anual neste ritmo:* *${_fmtCurrency(annualProjectedSavingsRs)} / ANO*');
    buf.writeln('━━━━━━━━━━━━━━━━━━━━');
    buf.writeln('👇 *Escolha uma opção abaixo para continuar:*');
    return buf.toString();
  }

  /// Botões pré-definidos para o agente no WhatsApp
  static List<Map<String, String>> predefinedButtons() => const [
        {
          'id': 'GD_GERAR_BOLETO',
          'title': 'GERAR BOLETO',
          'description': 'Gera o boleto demonstrativo em PDF e envia no WhatsApp',
        },
        {
          'id': 'GD_GERAR_PROPOSTA',
          'title': 'GERAR PROPOSTA PARA ESTA CONTA',
          'description': 'Segue o fluxo normal de proposta comercial',
        },
        {
          'id': 'GD_CANCELAR',
          'title': 'CANCELAR',
          'description': 'Cancela e reseta a conversa a qualquer hora',
        },
      ];
}

double _toDouble(dynamic value, {double fallback = 0.0}) {
  if (value == null) return fallback;
  if (value is num) return value.toDouble();
  final clean = value.toString().replaceAll('R\$', '').replaceAll(' ', '').replaceAll('.', '').replaceAll(',', '.');
  return double.tryParse(clean) ?? fallback;
}

double _normalizePercent(double raw) {
  if (raw > 0 && raw < 1) return raw * 100.0;
  return raw;
}

String _fmtCurrency(double v) {
  final fixed = v.toStringAsFixed(2);
  final parts = fixed.split('.');
  final intPart = parts[0];
  final decPart = parts[1];
  final reg = RegExp(r'(\d{1,3})(?=(\d{3})+(?!\d))');
  final formattedInt = intPart.replaceAllMapped(reg, (m) => '${m[1]}.');
  return 'R\$ $formattedInt,$decPart';
}

String _fmtInt(double v) {
  final intVal = v.round().toString();
  final reg = RegExp(r'(\d{1,3})(?=(\d{3})+(?!\d))');
  return intVal.replaceAllMapped(reg, (m) => '${m[1]}.');
}

String _fmtPct(double v) => '${v.toStringAsFixed(2).replaceAll('.', ',')}%';

String _defaultRefMonth() {
  const months = [
    'Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho',
    'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro',
  ];
  final now = DateTime.now();
  return '${months[now.month - 1]} / ${now.year}';
}
EOF

RUN cat <<'EOF' > /app/lib/services/cover_image_cache_service.dart
import 'dart:typed_data';
import 'package:http/http.dart' as http;

class CoverImageCacheService {
  static const String _storageBaseUrl =
      'https://firebasestorage.googleapis.com/v0/b/solardino-aea02.appspot.com/o';
  static final Map<String, Uint8List> _coverBytesCache = {};
  static final Map<String, Uint8List> _webBgBytesCache = {};

  static const String defaultCoverUrl =
      'https://firebasestorage.googleapis.com/v0/b/solardino-aea02.appspot.com/o/capas%2Fenergiasolar%2Fmodelo_proposta_1.jpg?alt=media';

  static String getBigCoverUrl(String fileName) {
    if (fileName.startsWith('http://') || fileName.startsWith('https://')) {
      return fileName;
    }
    final cleanName = fileName
        .replaceFirst('assets/modelo_propostas/', '')
        .replaceFirst('capas/energiasolar/', '');
    final encoded = Uri.encodeComponent('capas/energiasolar/$cleanName');
    return '$_storageBaseUrl/$encoded?alt=media';
  }

  static String getWebBackgroundUrl(String fileName) {
    if (fileName.startsWith('http://') || fileName.startsWith('https://')) {
      return fileName;
    }
    final cleanName = fileName
        .replaceFirst('assets/background_web/', '')
        .replaceFirst('assets/wallpaper_propostas/', '')
        .replaceFirst('wallpapers/energiasolar/', '')
        .replaceFirst('wallpapers/automacao/', '')
        .replaceFirst('capas/energiasolar/', '')
        .replaceFirst('capas/automacao/', '');

    if (cleanName.startsWith('modelo_proposta_')) {
      final encoded = Uri.encodeComponent('capas/energiasolar/$cleanName');
      return '$_storageBaseUrl/$encoded?alt=media';
    }
    if (cleanName.startsWith('modelo_automacao_')) {
      final encoded = Uri.encodeComponent('capas/automacao/$cleanName');
      return '$_storageBaseUrl/$encoded?alt=media';
    }

    final encoded = Uri.encodeComponent('wallpapers/energiasolar/$cleanName');
    return '$_storageBaseUrl/$encoded?alt=media';
  }

  static Future<Uint8List?> fetchCoverBytes(String fileName) async {
    final cleanName = fileName
        .replaceFirst('assets/modelo_propostas/', '')
        .replaceFirst('capas/energiasolar/', '');
    if (_coverBytesCache.containsKey(cleanName)) {
      return _coverBytesCache[cleanName];
    }
    try {
      final url = getBigCoverUrl(cleanName);
      final response = await http.get(Uri.parse(url)).timeout(const Duration(seconds: 10));
      if (response.statusCode == 200 && response.bodyBytes.isNotEmpty) {
        _coverBytesCache[cleanName] = response.bodyBytes;
        return response.bodyBytes;
      }
    } catch (_) {}
    return null;
  }

  static Future<Uint8List?> fetchWebBackgroundBytes(String fileName) async {
    final cleanName = fileName
        .replaceFirst('assets/background_web/', '')
        .replaceFirst('assets/wallpaper_propostas/', '')
        .replaceFirst('wallpapers/energiasolar/', '');
    if (_webBgBytesCache.containsKey(cleanName)) {
      return _webBgBytesCache[cleanName];
    }
    try {
      final url = getWebBackgroundUrl(cleanName);
      final response = await http.get(Uri.parse(url)).timeout(const Duration(seconds: 10));
      if (response.statusCode == 200 && response.bodyBytes.isNotEmpty) {
        _webBgBytesCache[cleanName] = response.bodyBytes;
        return response.bodyBytes;
      }
    } catch (_) {}
    return null;
  }

  static Future<Uint8List?> getCoverBytes([String? url]) async {
    final targetUrl = (url != null && url.isNotEmpty) ? url : defaultCoverUrl;

    if (_coverBytesCache.containsKey(targetUrl)) {
      return _coverBytesCache[targetUrl];
    }

    try {
      final res = await http.get(Uri.parse(targetUrl)).timeout(const Duration(seconds: 15));
      if (res.statusCode == 200 && res.bodyBytes.isNotEmpty) {
        _coverBytesCache[targetUrl] = res.bodyBytes;
        return res.bodyBytes;
      }
    } catch (e) {
      print('⚠️ [CoverImageCacheService] Falha ao baixar capa de $targetUrl: $e');
    }

    return null;
  }
}
EOF

RUN cat <<'EOF' > /app/lib/services/firebase_storage_service.dart
import 'dart:typed_data';
import 'package:http/http.dart' as http;
import '../models/proposal_dto.dart';

class FirebaseStorageService {
  static const String bucketName = 'solardino-aea02.appspot.com';

  /// Faz upload genérico de um arquivo PDF (ex: Boletos GD) para o Firebase Storage
  static Future<String?> uploadPdf({
    required Uint8List pdfBytes,
    required String fileName,
  }) async {
    try {
      final encodedPath = Uri.encodeComponent(fileName);
      final uploadUrl = Uri.parse(
        'https://firebasestorage.googleapis.com/v0/b/$bucketName/o?uploadType=media&name=$encodedPath',
      );

      final response = await http
          .post(
            uploadUrl,
            headers: {'Content-Type': 'application/pdf'},
            body: pdfBytes,
          )
          .timeout(const Duration(seconds: 25));

      if (response.statusCode == 200 || response.statusCode == 201) {
        return 'https://firebasestorage.googleapis.com/v0/b/$bucketName/o/$encodedPath?alt=media';
      }
      return null;
    } catch (e) {
      print('⚠️ [FirebaseStorageService] Erro uploadPdf: $e');
      return null;
    }
  }

  /// Faz upload do arquivo PDF gerado para o Firebase Storage
  static Future<Map<String, String>?> uploadProposalPdf({
    required Uint8List pdfBytes,
    required ProposalDTO proposal,
  }) async {
    try {
      final companyId = proposal.companyId != null && proposal.companyId!.isNotEmpty
          ? proposal.companyId!
          : 'default_company';
      final userId = proposal.createdByUserId != null && proposal.createdByUserId!.isNotEmpty
          ? proposal.createdByUserId!
          : 'default_user';

      final cleanPropNumber = proposal.proposalNumber.replaceAll('/', '_').replaceAll('-', '_');
      final fileName = 'Proposta_$cleanPropNumber.pdf';
      final storagePath = 'propostas_mavis/$companyId/$userId/$fileName';

      final encodedPath = Uri.encodeComponent(storagePath);
      final uploadUrl = Uri.parse(
        'https://firebasestorage.googleapis.com/v0/b/$bucketName/o?uploadType=media&name=$encodedPath',
      );

      final response = await http.post(
        uploadUrl,
        headers: {
          'Content-Type': 'application/pdf',
        },
        body: pdfBytes,
      ).timeout(const Duration(seconds: 25));

      final publicDownloadUrl =
          'https://firebasestorage.googleapis.com/v0/b/$bucketName/o/$encodedPath?alt=media';

      if (response.statusCode == 200 || response.statusCode == 201) {
        print('✅ [FirebaseStorageService] PDF salvo no Storage com sucesso: $storagePath');
        return {
          'pdfUrl': publicDownloadUrl,
          'pdfPath': storagePath,
          'fileName': fileName,
        };
      } else {
        print('⚠️ [FirebaseStorageService] Resposta HTTP ${response.statusCode}: ${response.body}');
        // Retorna o link padrão mesmo em caso de modo anônimo
        return {
          'pdfUrl': publicDownloadUrl,
          'pdfPath': storagePath,
          'fileName': fileName,
        };
      }
    } catch (e) {
      print('❌ [FirebaseStorageService] Erro ao enviar PDF: $e');
      return null;
    }
  }
}
EOF

RUN cat <<'EOF' > /app/lib/services/firestore_settings_service.dart
import 'dart:convert';
import 'package:http/http.dart' as http;
import '../models/proposal_dto.dart';
import '../models/solar_settings_dto.dart';

/// Serviço que busca as configurações de Usina Solar e Capa (`sector_settings/solarPlant`)
/// do Cloud Firestore (`mavis-crm-80885`) com cache em memória (TTL 5 minutos) e fallback
/// automático caso a cota do Firestore esteja esgotada (HTTP 429 RESOURCE_EXHAUSTED).
class FirestoreSettingsService {
  static const String _projectId = 'mavis-crm-80885';
  static const String _baseUrl =
      'https://firestore.googleapis.com/v1/projects/$_projectId/databases/(default)/documents';

  static final Map<String, Map<String, dynamic>> _docCache = {};
  static final Map<String, DateTime> _docCacheTime = {};
  static const Duration _cacheTtl = Duration(minutes: 5);

  static Future<SolarSettingsDTO> resolveSettings({
    required ProposalDTO proposal,
    Map<String, dynamic>? requestSettingsMap,
  }) async {
    final List<String> candidateCompanyIds = [];
    if (proposal.companyId != null &&
        proposal.companyId!.trim().isNotEmpty &&
        proposal.companyId != 'default_company') {
      candidateCompanyIds.add(proposal.companyId!.trim());
    }

    if (requestSettingsMap != null && requestSettingsMap['companyId'] != null) {
      final reqCid = requestSettingsMap['companyId'].toString().trim();
      if (reqCid.isNotEmpty && !candidateCompanyIds.contains(reqCid)) {
        candidateCompanyIds.add(reqCid);
      }
    }

    if (proposal.createdByUserId != null &&
        proposal.createdByUserId!.trim().isNotEmpty &&
        proposal.createdByUserId != 'default_user') {
      final uid = proposal.createdByUserId!.trim();
      if (!candidateCompanyIds.contains(uid)) {
        candidateCompanyIds.add(uid);
      }
    }

    for (final fallbackCid in [
      'GLOBAL_MASTER',
      '5NqpP8D5qRfbu7s8ZouYu1NIcKv1',
      '0Y5DVRzkIQXrb6wyyUwxslbxeOB2'
    ]) {
      if (!candidateCompanyIds.contains(fallbackCid)) {
        candidateCompanyIds.add(fallbackCid);
      }
    }

    Map<String, dynamic>? foundSolarSettings;
    String? resolvedCid;

    for (final cid in candidateCompanyIds) {
      final docMap = await _fetchFirestoreDoc('companies/$cid/sector_settings/solarPlant');
      if (docMap == null && _lastStatusWasQuotaExceeded) {
        // Se o Firestore retornou 429 (Quota Exceeded), interrompe buscas extras imediatamente
        break;
      }
      if (docMap != null && docMap.isNotEmpty) {
        foundSolarSettings = docMap;
        resolvedCid = cid;
        break;
      }
    }

    final Map<String, dynamic> merged = {};

    if (requestSettingsMap != null && requestSettingsMap.isNotEmpty) {
      merged.addAll(requestSettingsMap);
    }

    if (foundSolarSettings != null) {
      merged.addAll(foundSolarSettings);
      print('✅ [FirestoreSettingsService] Configurações da empresa ($resolvedCid) aplicadas!');
    }

    final targetCompanyId = resolvedCid ?? (candidateCompanyIds.isNotEmpty ? candidateCompanyIds.first : null);
    if (targetCompanyId != null && !_lastStatusWasQuotaExceeded) {
      final companyDoc = await _fetchFirestoreDoc('companies/$targetCompanyId');
      if (companyDoc != null && companyDoc.isNotEmpty) {
        void fillIfEmpty(String targetKey, dynamic fallbackValue) {
          if (fallbackValue == null) return;
          final str = fallbackValue.toString().trim();
          if (str.isEmpty) return;
          final current = merged[targetKey]?.toString().trim() ?? '';
          if (current.isEmpty) {
            merged[targetKey] = str;
          }
        }

        fillIfEmpty('companyName', companyDoc['name'] ?? companyDoc['tradeName']);
        fillIfEmpty('companyDocument', companyDoc['document'] ?? companyDoc['cnpj']);
        fillIfEmpty('companyPhone', companyDoc['phone']);
        fillIfEmpty('companyWebsite', companyDoc['website']);
        fillIfEmpty('companyInstagram', companyDoc['instagram']);
        fillIfEmpty('companySlogan', companyDoc['slogan']);
        fillIfEmpty('companyLogoBase64', companyDoc['logoBase64']);
      }
    }

    return SolarSettingsDTO.fromMap(merged);
  }

  static bool _lastStatusWasQuotaExceeded = false;

  static Future<Map<String, dynamic>?> _fetchFirestoreDoc(String relativePath) async {
    final now = DateTime.now();
    if (_docCache.containsKey(relativePath) && _docCacheTime.containsKey(relativePath)) {
      if (now.difference(_docCacheTime[relativePath]!) < _cacheTtl) {
        return _docCache[relativePath];
      }
    }

    try {
      final uri = Uri.parse('$_baseUrl/$relativePath');
      final response = await http.get(uri).timeout(const Duration(seconds: 3));
      if (response.statusCode == 200) {
        _lastStatusWasQuotaExceeded = false;
        final decoded = jsonDecode(response.body);
        if (decoded is Map<String, dynamic> && decoded['fields'] is Map<String, dynamic>) {
          final map = _decodeFieldsMap(decoded['fields'] as Map<String, dynamic>);
          _docCache[relativePath] = map;
          _docCacheTime[relativePath] = now;
          return map;
        }
      } else if (response.statusCode == 429) {
        _lastStatusWasQuotaExceeded = true;
        print('⚠️ [FirestoreSettingsService] Firestore HTTP 429 (Quota Exceeded). Usando cache/fallback.');
        return _docCache[relativePath];
      }
    } catch (e) {
      print('⚠️ [FirestoreSettingsService] Falha ao ler $relativePath: $e');
    }
    return _docCache[relativePath];
  }

  static Map<String, dynamic> _decodeFieldsMap(Map<String, dynamic> fields) {
    final result = <String, dynamic>{};
    fields.forEach((key, value) {
      result[key] = _decodeFirestoreValue(value);
    });
    return result;
  }

  static dynamic _decodeFirestoreValue(dynamic value) {
    if (value is! Map<String, dynamic>) return value;
    if (value.containsKey('stringValue')) return value['stringValue']?.toString() ?? '';
    if (value.containsKey('booleanValue')) return value['booleanValue'] == true;
    if (value.containsKey('integerValue')) {
      return int.tryParse(value['integerValue'].toString()) ?? 0;
    }
    if (value.containsKey('doubleValue')) {
      return (value['doubleValue'] as num?)?.toDouble() ??
          double.tryParse(value['doubleValue'].toString()) ??
          0.0;
    }
    if (value.containsKey('nullValue')) return null;
    if (value.containsKey('timestampValue')) return value['timestampValue']?.toString();
    if (value.containsKey('mapValue')) {
      final mapVal = value['mapValue'];
      if (mapVal is Map<String, dynamic> && mapVal['fields'] is Map<String, dynamic>) {
        return _decodeFieldsMap(mapVal['fields'] as Map<String, dynamic>);
      }
      return <String, dynamic>{};
    }
    if (value.containsKey('arrayValue')) {
      final arrVal = value['arrayValue'];
      if (arrVal is Map<String, dynamic> && arrVal['values'] is List) {
        return (arrVal['values'] as List).map(_decodeFirestoreValue).toList();
      }
      return <dynamic>[];
    }
    return null;
  }
}
EOF

RUN cat <<'EOF' > /app/lib/services/firestore_gd_service.dart
import 'dart:convert';
import 'package:http/http.dart' as http;
import '../models/solar_credit_dto.dart';

/// Serviço de consulta e lançamento de Créditos Solares (GD) no Cloud Firestore.
/// Restrito inicialmente à conta master `heitorklaus@hotmail.com`.
class FirestoreGdService {
  static const String _projectId = 'mavis-crm-80885';
  static const String _documentsBaseUrl =
      'https://firestore.googleapis.com/v1/projects/$_projectId/databases/(default)/documents';
  static const Set<String> _allowedEmails = {
    'heitorklaus@hotmail.com',
  };
  static const Set<String> _knownAdminCompanyIds = {
    '0Y5DVRzkIQXrb6wyyUwxslbxeOB2',
    '5NqpP8D5qRfbu7s8ZouYu1NIcKv1',
  };

  static bool isAllowedForAdmin({String? ownerEmail, String? companyId}) {
    final email = (ownerEmail ?? '').trim().toLowerCase();
    if (email.isNotEmpty) {
      return _allowedEmails.contains(email);
    }
    final cid = (companyId ?? '').trim();
    if (cid.isNotEmpty) {
      return _knownAdminCompanyIds.contains(cid);
    }
    return false;
  }

  /// Busca um recebedor de créditos cadastrado em `solar_credit_beneficiaries` pelo número da UC
  static Future<GdBeneficiaryDTO?> findBeneficiaryByUc({
    required String ucNumber,
    String? companyId,
  }) async {
    final digits = ucNumber.replaceAll(RegExp(r'\D'), '');
    if (digits.isEmpty) return null;

    final queryUrl = Uri.parse('$_documentsBaseUrl:runQuery');
    final filters = <Map<String, dynamic>>[
      {
        'fieldFilter': {
          'field': {'fieldPath': 'normalizedUcDigits'},
          'op': 'EQUAL',
          'value': {'stringValue': digits},
        },
      },
    ];

    if (companyId != null && companyId.trim().isNotEmpty) {
      filters.add({
        'fieldFilter': {
          'field': {'fieldPath': 'companyId'},
          'op': 'EQUAL',
          'value': {'stringValue': companyId.trim()},
        },
      });
    }

    final body = {
      'structuredQuery': {
        'from': [
          {'collectionId': 'solar_credit_beneficiaries'}
        ],
        'where': filters.length == 1
            ? filters.first
            : {
                'compositeFilter': {
                  'op': 'AND',
                  'filters': filters,
                },
              },
        'limit': 5,
      },
    };

    try {
      final resp = await http
          .post(
            queryUrl,
            headers: {'Content-Type': 'application/json'},
            body: jsonEncode(body),
          )
          .timeout(const Duration(seconds: 8));

      if (resp.statusCode != 200) {
        print('⚠️ [FirestoreGdService] runQuery falhou (${resp.statusCode}): ${resp.body}');
        return null;
      }

      final decoded = jsonDecode(resp.body);
      if (decoded is! List) return null;

      for (final row in decoded) {
        if (row is! Map || row['document'] == null) continue;
        final doc = Map<String, dynamic>.from(row['document'] as Map);
        final name = (doc['name'] ?? '').toString();
        final docId = name.split('/').last;
        final fields = doc['fields'] as Map<String, dynamic>? ?? {};
        final map = _decodeFirestoreFields(fields);
        final beneficiary = GdBeneficiaryDTO.fromMap(map, docId);
        if (beneficiary.status != 'inactive') {
          return beneficiary;
        }
      }
      return null;
    } catch (e) {
      print('⚠️ [FirestoreGdService] Erro ao buscar UC $digits: $e');
      return null;
    }
  }

  /// Grava o demonstrativo/boleto calculado na coleção `solar_credit_bills` do Firestore
  static Future<String?> saveBillToFirestore(GdBillCalculationDTO calc) async {
    final nowIso = DateTime.now().toUtc().toIso8601String();
    final url = Uri.parse('$_documentsBaseUrl/solar_credit_bills');

    final fields = _encodeFirestoreMap({
      'companyId': calc.beneficiary.companyId,
      'beneficiaryId': calc.beneficiary.id,
      'clientName': calc.beneficiary.clientName,
      'clientPhone': calc.beneficiary.clientPhone,
      'accountHolderName': calc.accountHolderName,
      'ucNumber': calc.ucNumber,
      'addressStreet': calc.addressStreet,
      'addressFull': calc.addressStreet,
      'generatorPlantId': calc.beneficiary.generatorPlantId,
      'generatorPlantName': calc.beneficiary.generatorPlantName,
      'generatorRegime': calc.beneficiary.generatorRegime,
      'utilityAllocationPercent': calc.utilityAllocationPercent,
      'clientDiscountPercent': calc.clientDiscountPercent,
      'referenceMonth': calc.referenceMonth,
      'dueDate': calc.dueDate,
      'consumptionKwh': calc.consumptionKwh,
      'consumptionValueRs': calc.consumptionValueRs,
      'injectedLines': calc.injectedLines.map((e) => e.toMap()).toList(),
      'injectedGdiKwh': calc.injectedGdiKwh,
      'injectedGdiValueRs': calc.injectedGdiValueRs,
      'injectedGdiiKwh': calc.injectedGdiiKwh,
      'injectedGdiiValueRs': calc.injectedGdiiValueRs,
      'totalInjectedKwh': calc.totalInjectedKwh,
      'totalInjectedGrossValueRs': calc.totalInjectedGrossValueRs,
      'gdAdjustmentKwh': calc.gdAdjustmentKwh,
      'gdAdjustmentTariff': calc.gdAdjustmentTariff,
      'gdAdjustmentValueRs': calc.gdAdjustmentValueRs,
      'publicLightingValueRs': calc.publicLightingValueRs,
      'finesAndInterestValueRs': calc.finesAndInterestValueRs,
      'otherChargesValueRs': calc.otherChargesValueRs,
      'utilityBillTotalToPayRs': calc.utilityBillTotalToPayRs,
      'accumulatedBalanceKwh': calc.accumulatedBalanceKwh,
      'netCompensatedCreditRs': calc.netCompensatedCreditRs,
      'solarCompanyAmountToPayRs': calc.solarCompanyAmountToPayRs,
      'totalWithSolarCompanyRs': calc.totalWithSolarCompanyRs,
      'totalWithoutSolarCompanyRs': calc.totalWithoutSolarCompanyRs,
      'monthlySavingsRs': calc.monthlySavingsRs,
      'annualProjectedSavingsRs': calc.annualProjectedSavingsRs,
      'paymentStatus': 'pending',
      'source': 'whatsapp_agent',
      'createdAt': DateTime.now().toUtc(),
      'updatedAt': DateTime.now().toUtc(),
    });

    // Garante timestamp válido no payload caso não use DateTime
    fields['createdAt'] = {'timestampValue': nowIso};
    fields['updatedAt'] = {'timestampValue': nowIso};

    try {
      final resp = await http
          .post(
            url,
            headers: {'Content-Type': 'application/json'},
            body: jsonEncode({'fields': fields}),
          )
          .timeout(const Duration(seconds: 8));
      if (resp.statusCode == 200 || resp.statusCode == 201) {
        final decoded = jsonDecode(resp.body) as Map<String, dynamic>;
        final docName = (decoded['name'] ?? '').toString();
        return docName.split('/').last;
      }
      print('⚠️ [FirestoreGdService] Erro ao salvar fatura (${resp.statusCode}): ${resp.body}');
      return null;
    } catch (e) {
      print('⚠️ [FirestoreGdService] Exceção ao salvar fatura: $e');
      return null;
    }
  }

  static Map<String, dynamic> _decodeFirestoreFields(Map<String, dynamic> fields) {
    final result = <String, dynamic>{};
    fields.forEach((key, val) {
      if (val is Map<String, dynamic>) {
        result[key] = _decodeFirestoreValue(val);
      }
    });
    return result;
  }

  static dynamic _decodeFirestoreValue(Map<String, dynamic> val) {
    if (val.containsKey('stringValue')) return val['stringValue'];
    if (val.containsKey('integerValue')) return int.tryParse(val['integerValue'].toString()) ?? 0;
    if (val.containsKey('doubleValue')) return (val['doubleValue'] as num).toDouble();
    if (val.containsKey('booleanValue')) return val['booleanValue'] == true;
    if (val.containsKey('timestampValue')) return val['timestampValue'];
    if (val.containsKey('nullValue')) return null;
    if (val.containsKey('arrayValue')) {
      final arr = val['arrayValue'] as Map<String, dynamic>? ?? {};
      final values = arr['values'] as List<dynamic>? ?? [];
      return values.whereType<Map<String, dynamic>>().map(_decodeFirestoreValue).toList();
    }
    if (val.containsKey('mapValue')) {
      final mv = val['mapValue'] as Map<String, dynamic>? ?? {};
      final fields = mv['fields'] as Map<String, dynamic>? ?? {};
      return _decodeFirestoreFields(fields);
    }
    return null;
  }

  static Map<String, dynamic> _encodeFirestoreMap(Map<String, dynamic> map) {
    final out = <String, dynamic>{};
    map.forEach((key, value) {
      out[key] = _encodeFirestoreValue(value);
    });
    return out;
  }

  static Map<String, dynamic> _encodeFirestoreValue(dynamic v) {
    if (v == null) return {'nullValue': null};
    if (v is bool) return {'booleanValue': v};
    if (v is int) return {'integerValue': v.toString()};
    if (v is double) return {'doubleValue': v};
    if (v is DateTime) return {'timestampValue': v.toUtc().toIso8601String()};
    if (v is List) {
      return {
        'arrayValue': {
          'values': v.map(_encodeFirestoreValue).toList(),
        },
      };
    }
    if (v is Map) {
      return {
        'mapValue': {
          'fields': _encodeFirestoreMap(Map<String, dynamic>.from(v)),
        },
      };
    }
    return {'stringValue': v.toString()};
  }
}
EOF

RUN cat <<'EOF' > /app/lib/generator/cover_divider_svg_builder.dart
import 'dart:math' as math;

/// Construtor de SVGs dos 10 divisores matemáticos / separadores da capa de propostas.
/// Replica com 100% de fidelidade visual os mesmos algoritmos de `SolarCoverDividerPainter`.
class CoverDividerSvgBuilder {
  static String buildSvg({
    required int dividerType,
    required double width,
    required double height,
    double splitYRatio = 0.70,
    required String primaryColorHex,
    required String bottomAreaColorHex,
  }) {
    final w = width;
    final h = height;
    final splitY = h * splitYRatio;

    final primaryHex = _formatHex(primaryColorHex, '#F59E0B');
    final bottomHex = _formatHex(bottomAreaColorHex, '#FFFFFF');
    final accentHex = _calculateAccentHex(primaryHex, bottomHex, factor: 0.60);

    if (dividerType < 0) {
      return '<svg viewBox="0 0 $w $h" width="$w" height="$h" xmlns="http://www.w3.org/2000/svg"></svg>';
    }

    final sb = StringBuffer();
    sb.writeln('<svg viewBox="0 0 $w $h" width="$w" height="$h" xmlns="http://www.w3.org/2000/svg">');

    switch (dividerType) {
      case 0:
        final p1 = _buildSampledPath(w, h, (x, t) {
          return splitY + math.sin(t * math.pi * 1.5) * (h * 0.045) - (t * h * 0.035);
        });
        final p2 = _buildSampledPath(w, h, (x, t) {
          return splitY + 12 + math.sin(t * math.pi * 1.5) * (h * 0.045) - (t * h * 0.035);
        });
        final pWhite = _buildSampledPath(w, h, (x, t) {
          return splitY + 28 + math.sin(t * math.pi * 1.5) * (h * 0.045) - (t * h * 0.035);
        });

        sb.writeln('  <path d="$p1" fill="$accentHex" />');
        sb.writeln('  <path d="$p2" fill="$primaryHex" />');
        sb.writeln('  <path d="$pWhite" fill="$bottomHex" />');
        break;

      case 1:
        final p1 = _buildSampledPath(w, h, (x, t) {
          return splitY + math.sin(t * math.pi * 2.2) * (h * 0.03) + math.cos(t * math.pi) * (h * 0.015);
        });
        final p2 = _buildSampledPath(w, h, (x, t) {
          return splitY + 10 + math.cos(t * math.pi * 1.8) * (h * 0.035);
        });
        final pWhite = _buildSampledPath(w, h, (x, t) {
          return splitY + 25 + math.cos(t * math.pi * 1.8) * (h * 0.035);
        });

        sb.writeln('  <path d="$p1" fill="$primaryHex" />');
        sb.writeln('  <path d="$p2" fill="$accentHex" />');
        sb.writeln('  <path d="$pWhite" fill="$bottomHex" />');
        break;

      case 2:
        sb.writeln('  <polygon points="0,${(splitY + 20).toStringAsFixed(1)} $w,${(splitY - 40).toStringAsFixed(1)} $w,$h 0,$h" fill="#0F172A" />');
        sb.writeln('  <polygon points="0,${(splitY + 32).toStringAsFixed(1)} $w,${(splitY - 28).toStringAsFixed(1)} $w,$h 0,$h" fill="$accentHex" />');
        sb.writeln('  <polygon points="0,${(splitY + 44).toStringAsFixed(1)} $w,${(splitY - 16).toStringAsFixed(1)} $w,$h 0,$h" fill="$primaryHex" />');
        sb.writeln('  <polygon points="0,${(splitY + 58).toStringAsFixed(1)} $w,${(splitY - 2).toStringAsFixed(1)} $w,$h 0,$h" fill="$bottomHex" />');
        break;

      case 3:
        final midX = (w * 0.65).toStringAsFixed(1);
        sb.writeln('  <polygon points="0,${(splitY + 15).toStringAsFixed(1)} $midX,${(splitY - 25).toStringAsFixed(1)} $w,${(splitY + 20).toStringAsFixed(1)} $w,$h 0,$h" fill="$accentHex" />');
        sb.writeln('  <polygon points="0,${(splitY + 30).toStringAsFixed(1)} $midX,${(splitY - 10).toStringAsFixed(1)} $w,${(splitY + 35).toStringAsFixed(1)} $w,$h 0,$h" fill="$primaryHex" />');
        sb.writeln('  <polygon points="0,${(splitY + 45).toStringAsFixed(1)} $midX,${(splitY + 5).toStringAsFixed(1)} $w,${(splitY + 50).toStringAsFixed(1)} $w,$h 0,$h" fill="$bottomHex" />');
        break;

      case 4:
        final p1 = _buildSampledPath(w, h, (x, t) {
          final relT = (x - w / 2) / (w / 2);
          return splitY - (1 - relT * relT) * (h * 0.05);
        });
        final p2 = _buildSampledPath(w, h, (x, t) {
          final relT = (x - w / 2) / (w / 2);
          return splitY + 14 - (1 - relT * relT) * (h * 0.05);
        });
        final pWhite = _buildSampledPath(w, h, (x, t) {
          final relT = (x - w / 2) / (w / 2);
          return splitY + 28 - (1 - relT * relT) * (h * 0.05);
        });

        sb.writeln('  <path d="$p1" fill="$accentHex" />');
        sb.writeln('  <path d="$p2" fill="$primaryHex" />');
        sb.writeln('  <path d="$pWhite" fill="$bottomHex" />');
        break;

      case 5:
        final x1 = (w * 0.35).toStringAsFixed(1);
        final x2 = (w * 0.75).toStringAsFixed(1);
        sb.writeln('  <polygon points="0,${(splitY + 25).toStringAsFixed(1)} $x1,${(splitY - 15).toStringAsFixed(1)} $x2,${(splitY + 10).toStringAsFixed(1)} $w,${(splitY - 20).toStringAsFixed(1)} $w,$h 0,$h" fill="$accentHex" />');
        sb.writeln('  <polygon points="0,${(splitY + 38).toStringAsFixed(1)} $x1,${(splitY - 2).toStringAsFixed(1)} $x2,${(splitY + 23).toStringAsFixed(1)} $w,${(splitY - 7).toStringAsFixed(1)} $w,$h 0,$h" fill="$primaryHex" />');
        sb.writeln('  <polygon points="0,${(splitY + 50).toStringAsFixed(1)} $x1,${(splitY + 10).toStringAsFixed(1)} $x2,${(splitY + 35).toStringAsFixed(1)} $w,${(splitY + 5).toStringAsFixed(1)} $w,$h 0,$h" fill="$bottomHex" />');
        break;

      case 6:
        final p1 = _buildSampledPath(w, h, (x, t) {
          return splitY + math.sin(t * math.pi * 3.0) * (h * 0.02) - (t * 10);
        });
        final p2 = _buildSampledPath(w, h, (x, t) {
          return splitY + 12 + math.sin(t * math.pi * 3.0) * (h * 0.02) - (t * 10);
        });
        final pWhite = _buildSampledPath(w, h, (x, t) {
          return splitY + 25 + math.sin(t * math.pi * 3.0) * (h * 0.02) - (t * 10);
        });

        sb.writeln('  <path d="$p1" fill="$accentHex" />');
        sb.writeln('  <path d="$p2" fill="$primaryHex" />');
        sb.writeln('  <path d="$pWhite" fill="$bottomHex" />');
        break;

      case 7:
        final hx1 = (w * 0.4).toStringAsFixed(1);
        final hx2 = (w * 0.52).toStringAsFixed(1);
        final hx1b = (w * 0.4 + 5).toStringAsFixed(1);
        final hx2b = (w * 0.52 + 5).toStringAsFixed(1);
        final hx1c = (w * 0.4 + 10).toStringAsFixed(1);
        final hx2c = (w * 0.52 + 10).toStringAsFixed(1);

        sb.writeln('  <polygon points="0,${(splitY - 10).toStringAsFixed(1)} $hx1,${(splitY - 10).toStringAsFixed(1)} $hx2,${(splitY + 30).toStringAsFixed(1)} $w,${(splitY + 30).toStringAsFixed(1)} $w,$h 0,$h" fill="$accentHex" />');
        sb.writeln('  <polygon points="0,${(splitY + 5).toStringAsFixed(1)} $hx1b,${(splitY + 5).toStringAsFixed(1)} $hx2b,${(splitY + 45).toStringAsFixed(1)} $w,${(splitY + 45).toStringAsFixed(1)} $w,$h 0,$h" fill="$primaryHex" />');
        sb.writeln('  <polygon points="0,${(splitY + 20).toStringAsFixed(1)} $hx1c,${(splitY + 20).toStringAsFixed(1)} $hx2c,${(splitY + 60).toStringAsFixed(1)} $w,${(splitY + 60).toStringAsFixed(1)} $w,$h 0,$h" fill="$bottomHex" />');
        break;

      case 8:
        final p1 = _buildSampledPath(w, h, (x, t) {
          final relT = (x - w / 2) / (w / 2);
          return splitY + (1 - relT * relT) * (h * 0.04);
        });
        final p2 = _buildSampledPath(w, h, (x, t) {
          final relT = (x - w / 2) / (w / 2);
          return splitY + 12 + (1 - relT * relT) * (h * 0.04);
        });
        final pWhite = _buildSampledPath(w, h, (x, t) {
          final relT = (x - w / 2) / (w / 2);
          return splitY + 25 + (1 - relT * relT) * (h * 0.04);
        });

        sb.writeln('  <path d="$p1" fill="$accentHex" />');
        sb.writeln('  <path d="$p2" fill="$primaryHex" />');
        sb.writeln('  <path d="$pWhite" fill="$bottomHex" />');
        break;

      case 9:
      default:
        final p1 = _buildSampledPath(w, h, (x, t) {
          return splitY + 30 + (0.5 - t) * (h * 0.08) + math.sin(t * math.pi) * (h * 0.02);
        });
        final p2 = _buildSampledPath(w, h, (x, t) {
          return splitY + 42 + (0.5 - t) * (h * 0.08) + math.sin(t * math.pi) * (h * 0.02);
        });
        final pWhite = _buildSampledPath(w, h, (x, t) {
          return splitY + 55 + (0.5 - t) * (h * 0.08) + math.sin(t * math.pi) * (h * 0.02);
        });

        sb.writeln('  <path d="$p1" fill="$accentHex" />');
        sb.writeln('  <path d="$p2" fill="$primaryHex" />');
        sb.writeln('  <path d="$pWhite" fill="$bottomHex" />');
        break;
    }

    sb.writeln('</svg>');
    return sb.toString();
  }

  static String _buildSampledPath(
    double w,
    double h,
    double Function(double x, double t) yFunc, {
    double step = 8.0,
  }) {
    final sb = StringBuffer();
    final y0 = yFunc(0.0, 0.0);
    sb.write('M 0 ${y0.toStringAsFixed(2)}');

    for (double x = step; x < w; x += step) {
      final t = x / w;
      final y = yFunc(x, t);
      sb.write(' L ${x.toStringAsFixed(1)} ${y.toStringAsFixed(2)}');
    }

    final yEnd = yFunc(w, 1.0);
    sb.write(' L ${w.toStringAsFixed(1)} ${yEnd.toStringAsFixed(2)}');
    sb.write(' L ${w.toStringAsFixed(1)} ${h.toStringAsFixed(1)}');
    sb.write(' L 0 ${h.toStringAsFixed(1)} Z');
    return sb.toString();
  }

  static String _formatHex(String? raw, String fallback) {
    if (raw == null || raw.isEmpty) return fallback;
    var clean = raw.replaceAll('#', '').trim();
    if (clean.length == 8) {
      clean = clean.substring(2);
    }
    if (clean.length != 6) return fallback;
    return '#$clean';
  }

  static String _calculateAccentHex(String primaryHex, String bottomHex, {double factor = 0.60}) {
    try {
      final pClean = primaryHex.replaceAll('#', '');
      final bClean = bottomHex.replaceAll('#', '');

      final pR = int.parse(pClean.substring(0, 2), radix: 16);
      final pG = int.parse(pClean.substring(2, 4), radix: 16);
      final pB = int.parse(pClean.substring(4, 6), radix: 16);

      final bR = int.parse(bClean.substring(0, 2), radix: 16);
      final bG = int.parse(bClean.substring(2, 4), radix: 16);
      final bB = int.parse(bClean.substring(4, 6), radix: 16);

      final aR = (bR + (pR - bR) * factor).round().clamp(0, 255);
      final aG = (bG + (pG - bG) * factor).round().clamp(0, 255);
      final aB = (bB + (pB - bB) * factor).round().clamp(0, 255);

      return '#${aR.toRadixString(16).padLeft(2, '0')}${aG.toRadixString(16).padLeft(2, '0')}${aB.toRadixString(16).padLeft(2, '0')}';
    } catch (_) {
      return primaryHex;
    }
  }
}
EOF

