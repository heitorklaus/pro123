  int get verticalSplitAccentColorValue => _hexToColor(verticalSplitAccentColor, fallback: 0xFFEAB308);
  int get coverHeadlineColorValue => _hexToColor(coverHeadlineColor, fallback: 0xFFFFFFFF);
